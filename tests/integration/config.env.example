# Integration suite configuration. Copy to config.env (gitignored), or point IT_CONFIG at another
# file. Variables already set in the environment win.

# Throwaway public repos, all under one personal account, created empty. Everything in them is
# deleted and overwritten on every run. Usually left out here: init-integration-repos creates
# them and records them in repos.env, which wins over these. Set them only for repos made by
# hand; case 12's longer-name check needs the second service repo's name to start with the
# testbed's plus "-".
#IT_DISTRIBUTOR_REPO=you/it-distributor
#IT_TESTBED_REPO=you/it-testbed
#IT_SERVICE2_REPO=you/it-testbed-tools

# Local checkouts whose HEAD commits are force-pushed to the throwaway repos (must be clean).
IT_DISTRIBUTOR_DIR=~/projects/openchami/distributor
IT_TESTBED_DIR=~/projects/openchami/github-actions-testbed

# Optional: a command printing a dummy account's token (write role on the testbed only), for
# the release publisher check's rejection case once that exists. Read at run time, so the token
# never sits in this file. Example: gh auth token --user you-dummy
#IT_DUMMY_TOKEN_CMD=

# Optional: where the report and logs go (default /tmp/distributor-it/<run id>).
#IT_OUTPUT_DIR=/tmp/distributor-it

# Optional: seconds a wait may take before a case errors, and between checks while waiting.
#IT_TIMEOUT=3600
#IT_POLL_INTERVAL=20

# Optional: podman or docker (default: podman if installed, else docker).
#IT_ENGINE=

# Optional: set to skip teardown and keep the run's releases, issues, and runs for inspection.
#IT_KEEP=1
