#!/usr/bin/env bash
# Runs the distributor's integration suite against throwaway GitHub repos.
#
#   tests/integration/run-integration-test all | <case>...
#
# Every phase runs in its own transient container (podman, or docker): setup, one container per
# case, the dnf and apt client checks, teardown. Phases share a RAM-backed run directory
# (/dev/shm), deleted on exit; the report and logs stay in IT_OUTPUT_DIR. The GitHub token goes
# to each container on stdin only.
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
# Ordered so each case builds on the last (release by release), then the crafted-release cases.
ALL=(02 11 01 03 05 04 06 09 14 08 10 07 12 13)
REQUIRED=(IT_DISTRIBUTOR_REPO IT_TESTBED_REPO IT_SERVICE2_REPO IT_DISTRIBUTOR_DIR IT_TESTBED_DIR)
OPTIONAL=(IT_DUMMY_TOKEN_CMD IT_OUTPUT_DIR IT_TIMEOUT IT_POLL_INTERVAL IT_ENGINE IT_KEEP)
TOOLS_IMAGE=docker.io/library/fedora:42
DEBIAN_IMAGE=docker.io/library/debian:13

log() { printf '%s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 2; }

usage() {
  cat >&2 << EOF
usage: run-integration-test all | <case>...

Cases are the numbers of the files in tests/integration/cases (e.g. 9 or 09). Configuration
comes from \$IT_CONFIG (default tests/integration/config.env) and \$IT_REPOS (default
tests/integration/repos.env, written by init-integration-repos); the environment wins.
EOF
  exit 2
}

# --- Configuration -----------------------------------------------------------------------------

load_config() {
  local file=${IT_CONFIG:-$HERE/config.env} saved name
  # The environment overrides the file: remember what's set, source, then restore it.
  saved=$(for name in "${REQUIRED[@]}" "${OPTIONAL[@]}"; do
    if [[ -v $name ]]; then declare -p "$name"; fi
  done)
  if [[ -f $file ]]; then
    # shellcheck source=/dev/null
    source "$file"
  elif [[ -n ${IT_CONFIG:-} ]]; then
    die "config file not found: $file"
  fi
  # The repos init-integration-repos created, when it did; they replace any in the config file.
  if [[ -f ${IT_REPOS:-$HERE/repos.env} ]]; then
    # shellcheck source=/dev/null
    source "${IT_REPOS:-$HERE/repos.env}"
  fi
  # declare -p output declares locals inside a function; -g keeps them global.
  eval "${saved//declare -/declare -g -}"
  for name in "${REQUIRED[@]}"; do
    [[ -n ${!name:-} ]] || die "$name is required (see tests/integration/config.env.example)"
  done
  IT_DISTRIBUTOR_DIR=$(realpath "${IT_DISTRIBUTOR_DIR/#\~/$HOME}")
  IT_TESTBED_DIR=$(realpath "${IT_TESTBED_DIR/#\~/$HOME}")
  IT_TIMEOUT=${IT_TIMEOUT:-3600}
  IT_POLL_INTERVAL=${IT_POLL_INTERVAL:-20}
  local dir
  for dir in "$IT_DISTRIBUTOR_DIR" "$IT_TESTBED_DIR"; do
    git -C "$dir" rev-parse --git-dir > /dev/null 2>&1 || die "$dir: not a git checkout"
    # The suite pushes HEAD; uncommitted changes wouldn't be tested.
    [[ -z $(git -C "$dir" status --porcelain --untracked-files=no) ]] \
      || die "$dir: uncommitted changes (the suite tests the HEAD commit)"
  done
}

pick_engine() {
  if [[ -n ${IT_ENGINE:-} ]]; then
    ENGINE=$IT_ENGINE
  elif command -v podman > /dev/null; then
    ENGINE=podman
  elif command -v docker > /dev/null; then
    ENGINE=docker
  else
    die "needs podman or docker"
  fi
  command -v "$ENGINE" > /dev/null || die "$ENGINE not found"
  # Docker containers run as root; entry.sh hands shared files back to this user.
  CHOWN=
  if [[ $ENGINE == docker ]]; then CHOWN="$(id -u):$(id -g)"; fi
}

get_tokens() {
  local scopes
  command -v gh > /dev/null || die "needs gh, logged in (gh auth login)"
  TOKEN=$(gh auth token) || die "gh isn't logged in (gh auth login)"
  # Classic tokens list their scopes; fine-grained ones don't, and are checked by use.
  scopes=$(GH_TOKEN=$TOKEN gh api -i user 2> /dev/null | tr -d '\r' \
    | sed -n 's/^[Xx]-[Oo][Aa]uth-[Ss]copes: //p')
  if [[ -n $scopes ]]; then
    [[ ,${scopes// /}, == *,repo,* ]] \
      || die "the gh token needs the repo scope (gh auth refresh -s repo)"
    [[ ,${scopes// /}, == *,workflow,* ]] \
      || die "the gh token needs the workflow scope (gh auth refresh -s workflow)"
  fi
  DUMMY_TOKEN=
  if [[ -n ${IT_DUMMY_TOKEN_CMD:-} ]]; then
    DUMMY_TOKEN=$(bash -c "$IT_DUMMY_TOKEN_CMD") || die "IT_DUMMY_TOKEN_CMD failed"
  fi
}

# --- Containers --------------------------------------------------------------------------------

# Runs entry.sh in a transient tools container; output goes to the terminal and the run log.
phase() { # <entry.sh args...>
  local rc
  printf '%s\n%s\n' "$TOKEN" "$DUMMY_TOKEN" | "$ENGINE" run --rm -i \
    --security-opt label=disable \
    --tmpfs /work:exec --tmpfs /tmp:exec \
    -v "$RUN_DIR:/it-run" -v "$OUT_DIR:/it-out" -v "$RUN_DIR/dnf-cache:/var/cache/libdnf5" \
    -v "$HERE:/suite:ro" \
    -v "$IT_DISTRIBUTOR_DIR:/src/distributor:ro" -v "$IT_TESTBED_DIR:/src/testbed:ro" \
    -e "IT_DISTRIBUTOR_REPO=$IT_DISTRIBUTOR_REPO" -e "IT_TESTBED_REPO=$IT_TESTBED_REPO" \
    -e "IT_SERVICE2_REPO=$IT_SERVICE2_REPO" -e "IT_TIMEOUT=$IT_TIMEOUT" \
    -e "IT_POLL_INTERVAL=$IT_POLL_INTERVAL" -e "IT_CHOWN=$CHOWN" \
    "$TOOLS_IMAGE" bash /suite/lib/entry.sh "$@" 2>&1 | tee -a "$OUT_DIR/log.txt"
  rc=${PIPESTATUS[1]}
  return "$rc"
}

# Installs <package> from a case's downloaded target with dnf and with apt, signatures checked.
client_checks() { # <dir under OUT_DIR> <package>
  local dir=$OUT_DIR/$1 pkg=$2
  log "--- client checks: $pkg from $1"
  "$ENGINE" run --rm --security-opt label=disable -v "$dir/rpm:/repo:ro" "$TOOLS_IMAGE" bash -c "
    printf '[it]\nname=it\nbaseurl=file:///repo/rpm\ngpgcheck=1\nrepo_gpgcheck=1\ngpgkey=file:///repo/keys/archive.asc\n' \
      > /etc/yum.repos.d/it.repo
    dnf -y -q --disablerepo='*' --enablerepo=it install $pkg && rpm -q $pkg" 2>&1 \
    | tee -a "$OUT_DIR/log.txt" || return 1
  "$ENGINE" run --rm --security-opt label=disable -v "$dir/deb:/repo:ro" "$DEBIAN_IMAGE" bash -c "
    install -Dm644 /repo/keys/archive.asc /etc/apt/keyrings/it.asc
    echo 'deb [signed-by=/etc/apt/keyrings/it.asc] file:/repo/deb stable main' > /etc/apt/it.list
    apt=(apt-get -o Dir::Etc::sourcelist=/etc/apt/it.list -o Dir::Etc::sourceparts=-)
    \"\${apt[@]}\" update -qq && \"\${apt[@]}\" install -y -qq $pkg && dpkg -s $pkg | grep ^Version" 2>&1 \
    | tee -a "$OUT_DIR/log.txt" || return 1
}

# shellcheck disable=SC2329 # runs from the EXIT trap
cleanup() {
  [[ -d ${RUN_DIR:-} ]] || return 0
  rm -rf "$RUN_DIR" 2> /dev/null && return 0
  # Root-owned leftovers (a docker container killed before it handed files back).
  "$ENGINE" run --rm --security-opt label=disable -v "$RUN_DIR:/it-run" "$TOOLS_IMAGE" \
    find /it-run -mindepth 1 -delete 2> /dev/null || true
  rmdir "$RUN_DIR" 2> /dev/null || log "warning: couldn't remove $RUN_DIR"
}

# --- Run ---------------------------------------------------------------------------------------

[[ $# -gt 0 ]] || usage
case $1 in -h | --help) usage ;; esac
CASES=()
for arg in "$@"; do
  if [[ $arg == all ]]; then
    CASES+=("${ALL[@]}")
  elif [[ $arg =~ ^[0-9]+$ ]] \
    && compgen -G "$HERE/cases/$(printf %02d "$((10#$arg))")-*.sh" > /dev/null; then
    CASES+=("$(printf %02d "$((10#$arg))")")
  else
    die "unknown case: $arg"
  fi
done

load_config
pick_engine
get_tokens

ID=$(date -u +%Y%m%dT%H%M%SZ)
RUN_DIR=/dev/shm/distributor-it-$ID
OUT_DIR=${IT_OUTPUT_DIR:-/tmp/distributor-it}/$ID
mkdir -m 700 "$RUN_DIR"
mkdir "$RUN_DIR/dnf-cache"
mkdir -p "$OUT_DIR"
trap cleanup EXIT
log "run $ID: ${CASES[*]} (engine $ENGINE, output $OUT_DIR)"

report=$OUT_DIR/report.tsv
printf 'case\tresult\tseconds\tmessage\truns\n' > "$report"
worst=0

log "--- setup"
if ! phase setup; then
  printf 'setup\terror\t\tsetup failed (see log.txt)\t\n' >> "$report"
  worst=2
  CASES=()
fi

for c in "${CASES[@]}"; do
  log "--- case $c"
  start=$SECONDS rc=0
  phase case "$c" || rc=$?
  case $rc in 0) result=pass ;; 1) result=fail ;; 3) result=skip ;; *) result=error ;; esac
  msg=$(cat "$RUN_DIR/results/$c.msg" 2> /dev/null || true)
  if [[ $result == pass && -s $RUN_DIR/client/$c ]]; then
    while IFS=$'\t' read -r dir pkg; do
      client_checks "$dir" "$pkg" || { result=fail msg="client install of $pkg failed"; }
    done < "$RUN_DIR/client/$c"
  fi
  runs=$(sed "s|^|https://github.com/$IT_DISTRIBUTOR_REPO/actions/runs/|" \
    "$RUN_DIR/results/$c.runs" 2> /dev/null | paste -sd' ' || true)
  printf '%s\t%s\t%s\t%s\t%s\n' "$c" "$result" "$((SECONDS - start))" "$msg" "$runs" >> "$report"
  case $result in fail) ((worst < 1)) && worst=1 ;; error) worst=2 ;; esac
done

if [[ -n ${IT_KEEP:-} ]]; then
  log "--- teardown skipped (IT_KEEP): the repos keep this run's releases, issues, and runs"
else
  log "--- teardown"
  phase teardown || { log "warning: teardown failed (see log.txt)"; ((worst < 2)) && worst=2; }
fi

log ""
column -t -s $'\t' "$report" >&2 || cat "$report" >&2
log "report: $report"
exit "$worst"
