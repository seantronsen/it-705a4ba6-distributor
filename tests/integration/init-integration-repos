#!/usr/bin/env bash
# Creates the suite's three throwaway repos under your GitHub account, with a random shared name,
# and records them in repos.env (gitignored), which run-integration-test and
# destroy-integration-repos read.
#
#   tests/integration/init-integration-repos
#
#   <base>-distributor     the distributor
#   <base>-testbed         the testbed
#   <base>-testbed-tools   the second service repo (its name starts with the testbed's plus "-")
#
# The repos are public and empty; run-integration-test fills them. Delete them with
# destroy-integration-repos.
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
REPOS_FILE=${IT_REPOS:-$HERE/repos.env}

log() { printf '%s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 2; }

[[ ! -e $REPOS_FILE ]] \
  || die "$REPOS_FILE exists: repos are already initialized (destroy-integration-repos first)"
command -v gh > /dev/null || die "needs gh, logged in (gh auth login)"
owner=$(gh api user -q .login) || die "gh isn't logged in (gh auth login)"
[[ ${owner,,} != openchami ]] || die "refusing to create repos under OpenCHAMI"

base=it-$(head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n')
names=("$base-distributor" "$base-testbed" "$base-testbed-tools")
for name in "${names[@]}"; do
  ! gh api "repos/$owner/$name" > /dev/null 2>&1 || die "$owner/$name already exists"
done

# Recorded before anything is created, so a failure part way still leaves destroy a list.
{
  echo "# Written by init-integration-repos; read by run-integration-test and"
  echo "# destroy-integration-repos. Delete the repos with destroy-integration-repos."
  echo "IT_DISTRIBUTOR_REPO=$owner/${names[0]}"
  echo "IT_TESTBED_REPO=$owner/${names[1]}"
  echo "IT_SERVICE2_REPO=$owner/${names[2]}"
} > "$REPOS_FILE"

for name in "${names[@]}"; do
  gh repo create "$owner/$name" --public \
    --description "distributor integration test repo (throwaway)" > /dev/null
  log "created $owner/$name"
done
log "recorded in $REPOS_FILE"
