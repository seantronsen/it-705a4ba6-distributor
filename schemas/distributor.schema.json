{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "distributor.schema.json",
  "title": "Distributor config (config/distributor.yaml)",
  "description": "Who may publish, and the service repos to poll. See the comments in config/distributor.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "architectures", "max_releases", "archive_key", "publishers", "repos"],
  "properties": {
    "target": {
      "description": "Where to publish.",
      "type": "object",
      "additionalProperties": false,
      "required": ["s3"],
      "properties": {
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket", "region", "metadata_max_age"],
          "properties": {
            "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
            "region": { "type": "string", "minLength": 1 },
            "endpoint": {
              "description": "For S3-compatible services other than AWS.",
              "type": "string",
              "pattern": "^https?://"
            },
            "metadata_max_age": {
              "description": "Seconds caches may keep metadata and keys (Cache-Control max-age), e.g. 300.",
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "architectures": {
      "description": "The architectures published, per format.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rpm", "deb"],
      "properties": {
        "rpm": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["x86_64", "aarch64", "noarch"] }
        },
        "deb": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["amd64", "arm64", "all"] }
        }
      }
    },
    "max_releases": {
      "description": "The most releases one poll admits (GitHub caps a job matrix at 256).",
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "archive_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warn_days"],
      "properties": {
        "warn_days": {
          "description": "Days of warning before the archive key expires, and the grace period before a key switch is due.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "publishers": {
      "description": "Keyed by GitHub user ID (gh api users/<username> -q .id), the only thing checked.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username"],
        "properties": {
          "username": {
            "description": "GitHub username; a label for readers.",
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
          },
          "repos": {
            "description": "The repos this publisher may publish. Leave it out for every repo.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/repoName" }
          }
        }
      }
    },
    "repos": {
      "description": "Keyed by owner/repo on GitHub.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/repoName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allow": {
            "default": [],
            "description": "Extra package names beyond <repo> and <repo>-*.",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$" }
          },
          "deny": {
            "default": [],
            "description": "Revoked repo keys.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fingerprint"],
              "properties": {
                "fingerprint": {
                  "description": "The repo key's fingerprint, uppercase and quoted.",
                  "type": "string",
                  "pattern": "^[0-9A-F]{40}$"
                },
                "since": {
                  "description": "UTC timestamp, YYYY-MM-DDTHH:MM:SSZ (what jq's fromdateiso8601 parses), quoted: prune only what was admitted from then on.",
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "reason": { "type": "string" }
              }
            }
          },
          "retain": {
            "default": [],
            "description": "Exact package versions never pruned.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "version"],
              "properties": {
                "package": { "type": "string", "minLength": 1 },
                "version": {
                  "description": "major.minor.patch, quoted.",
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "reason": { "type": "string" }
              }
            }
          },
          "keep_releases": {
            "default": [],
            "description": "major.minor lines kept past end of life, quoted (unquoted 1.10 reads as 1.1).",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
          }
        }
      }
    }
  },
  "$defs": {
    "repoName": {
      "description": "owner/repo on GitHub.",
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
    }
  }
}
